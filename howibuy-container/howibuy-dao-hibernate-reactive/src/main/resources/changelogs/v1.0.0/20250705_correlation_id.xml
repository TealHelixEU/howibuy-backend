<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd
	http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd"
>
	<changeSet id="correlation_id_related" author="nikospara">
		<createTable tableName="TH_CORREL_ID" remarks="Mapping of correlation ids from retailer apps to HowiBuy users">
			<column name="retailer_id" type="UUID" remarks="The retailer primary key">
				<constraints nullable="false" notNullConstraintName="NL_TH_CORREL_ID__RETAILER_ID" />
			</column>
			<column name="correlation_id" type="VARCHAR(100)" remarks="The correlation id for this retailer">
				<constraints nullable="false" notNullConstraintName="NL_TH_CORREL_ID__CORRELATION_ID" />
			</column>
			<column name="user_id" type="UUID" remarks="The user primary key">
				<constraints nullable="false" notNullConstraintName="NL_TH_CORREL_ID__USER_ID" />
			</column>
		</createTable>
		<addPrimaryKey tableName="TH_CORREL_ID" constraintName="PK_TH_CORREL_ID" columnNames="retailer_id, correlation_id" />
		<addForeignKeyConstraint baseTableName="TH_CORREL_ID" baseColumnNames="user_id" constraintName="FK_TH_CORREL_ID__USER_ID__TH_USER_PROFILE__ID" referencedTableName="TH_USER_PROFILE" referencedColumnNames="id" />
		<addForeignKeyConstraint baseTableName="TH_CORREL_ID" baseColumnNames="retailer_id" constraintName="FK_TH_CORREL_ID__RETAILER_ID__TH_RETAILER__ID" referencedTableName="TH_RETAILER" referencedColumnNames="id" />
	</changeSet>
</databaseChangeLog>
