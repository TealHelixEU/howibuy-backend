<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd
	http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd"
>
	<changeSet id="purchased_basket_product_personal_overall_score" author="nikospara">
		<renameColumn tableName="TH_PURCHASED_BASKET_PRODUCT" oldColumnName="overall_score" newColumnName="personal_overall_score" />
		<setColumnRemarks tableName="TH_PURCHASED_BASKET_PRODUCT" columnName="personal_overall_score" remarks="The Overall Score under the Weighting Profile in force for the user, which the Basket Match is judged on" />
		<rollback>
			<setColumnRemarks tableName="TH_PURCHASED_BASKET_PRODUCT" columnName="personal_overall_score" remarks="The Overall Score under the Weighting Profile in force" />
			<renameColumn tableName="TH_PURCHASED_BASKET_PRODUCT" oldColumnName="personal_overall_score" newColumnName="overall_score" />
		</rollback>
	</changeSet>

	<!--
		No default: the baskets stored under the stub rules are deleted by hand before this runs, and a database that still
		holds some fails here rather than keep a score that was never computed.
	-->
	<changeSet id="purchased_basket_product_scientific_overall_score" author="nikospara">
		<addColumn tableName="TH_PURCHASED_BASKET_PRODUCT">
			<column name="scientific_overall_score" type="DOUBLE PRECISION" remarks="The Overall Score under the scientific Weighting Profile, which the XP and the Problematic Products are judged on">
				<constraints nullable="false" notNullConstraintName="NL_TH_PURCHASED_BASKET_PRODUCT__SCIENTIFIC_OVERALL_SCORE" />
			</column>
		</addColumn>
	</changeSet>

	<changeSet id="purchased_basket_product_drop_product_grade" author="nikospara">
		<dropColumn tableName="TH_PURCHASED_BASKET_PRODUCT" columnName="product_grade" />
		<rollback>
			<addColumn tableName="TH_PURCHASED_BASKET_PRODUCT">
				<column name="product_grade" type="VARCHAR(1)" remarks="The Product Grade, A, B or C">
					<constraints nullable="false" notNullConstraintName="NL_TH_PURCHASED_BASKET_PRODUCT__PRODUCT_GRADE" />
				</column>
			</addColumn>
		</rollback>
	</changeSet>

	<changeSet id="purchased_basket_drop_basket_grade" author="nikospara">
		<dropColumn tableName="TH_PURCHASED_BASKET" columnName="basket_grade" />
		<rollback>
			<addColumn tableName="TH_PURCHASED_BASKET">
				<column name="basket_grade" type="VARCHAR(1)" remarks="The Basket Grade, A, B or C; null when there was nothing to assess" />
			</addColumn>
		</rollback>
	</changeSet>

	<changeSet id="purchased_basket_basket_match" author="nikospara">
		<addColumn tableName="TH_PURCHASED_BASKET">
			<column name="basket_match" type="VARCHAR(20)" remarks="The Basket Match, EXCELLENT, GOOD or NEEDS_IMPROVEMENT; null when there was nothing to assess" />
		</addColumn>
	</changeSet>

	<changeSet id="user_profile_streak" author="nikospara">
		<addColumn tableName="TH_USER_PROFILE">
			<column name="streak" type="INT" defaultValueNumeric="0" remarks="The number of the user's Purchased Baskets in a row, in the order they were registered, each with a product above 0.8 on the scientific Overall Score">
				<constraints nullable="false" notNullConstraintName="NL_TH_USER_PROFILE__STREAK" />
			</column>
		</addColumn>
	</changeSet>

	<changeSet id="user_badge" author="nikospara">
		<createTable tableName="TH_USER_BADGE" remarks="A Badge a user has earned, kept whatever the rule that awarded it becomes">
			<column name="user_profile_id" type="UUID" remarks="The user who earned the badge; part of the primary key">
				<constraints nullable="false" notNullConstraintName="NL_TH_USER_BADGE__USER_PROFILE_ID" primaryKey="true" primaryKeyName="PK_TH_USER_BADGE" />
			</column>
			<column name="badge" type="VARCHAR(50)" remarks="The code of the badge, the name of its constant in the Badge enum; part of the primary key">
				<constraints nullable="false" notNullConstraintName="NL_TH_USER_BADGE__BADGE" primaryKey="true" primaryKeyName="PK_TH_USER_BADGE" />
			</column>
			<column name="purchased_basket_id" type="UUID" remarks="The Purchased Basket whose purchase awarded the badge">
				<constraints nullable="false" notNullConstraintName="NL_TH_USER_BADGE__PURCHASED_BASKET_ID" />
			</column>
			<column name="earned_at" type="TIMESTAMP" remarks="When the user earned the badge">
				<constraints nullable="false" notNullConstraintName="NL_TH_USER_BADGE__EARNED_AT" />
			</column>
		</createTable>
		<addForeignKeyConstraint baseTableName="TH_USER_BADGE" baseColumnNames="user_profile_id" constraintName="FK_USER_BADGE__USER_PROFILE_ID" referencedTableName="TH_USER_PROFILE" referencedColumnNames="id" />
		<addForeignKeyConstraint baseTableName="TH_USER_BADGE" baseColumnNames="purchased_basket_id" constraintName="FK_USER_BADGE__PURCHASED_BASKET_ID" referencedTableName="TH_PURCHASED_BASKET" referencedColumnNames="id" />
	</changeSet>
</databaseChangeLog>
