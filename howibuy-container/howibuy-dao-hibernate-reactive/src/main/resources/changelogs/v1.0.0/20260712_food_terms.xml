<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd
	http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd"
>
	<changeSet id="food_terms_schema" author="nikospara">
		<createTable tableName="TH_FOOD_TERM" remarks="Glossary of generic food terms per language, used to enrich product names before AI classification">
			<column name="id" type="UUID" remarks="The primary key">
				<constraints primaryKey="true" primaryKeyName="PK_TH_FOOD_TERM" />
			</column>
			<column name="lang" type="VARCHAR(8)" remarks="ISO 639-1 language code of the term, e.g. 'el', 'lt'">
				<constraints nullable="false" notNullConstraintName="NL_TH_FOOD_TERM__LANG" />
			</column>
			<column name="term" type="VARCHAR(255)" remarks="The generic food term in its native language, brand-stripped, e.g. 'Ανθότυρος'">
				<constraints nullable="false" notNullConstraintName="NL_TH_FOOD_TERM__TERM" />
			</column>
			<column name="canonical_en" type="VARCHAR(255)" remarks="The canonical English name of the food, e.g. 'anthotyros'">
				<constraints nullable="false" notNullConstraintName="NL_TH_FOOD_TERM__CANONICAL_EN" />
			</column>
			<column name="description" type="VARCHAR(1024)" remarks="English description with an explicit category anchor, injected to enrich classification">
				<constraints nullable="false" notNullConstraintName="NL_TH_FOOD_TERM__DESCRIPTION" />
			</column>
			<column name="category_hint" type="VARCHAR(255)" remarks="Optional SAFAD taxonomy path locating the term, from L1 downward, node names separated by ' → ' (U+2192); written as deep as known, e.g. 'Milk and dairy products → Cheese'; null if unknown" />
		</createTable>
		<addUniqueConstraint tableName="TH_FOOD_TERM" columnNames="lang, term" constraintName="UQ_TH_FOOD_TERM__LANG_TERM" />
	</changeSet>

	<changeSet id="food_terms_data_gr" author="nikospara" context="appdata">
		<loadData tableName="TH_FOOD_TERM" file="db/glossary/food_term_gr.csv" relativeToChangelogFile="false">
			<column name="id" type="UUID" />
			<column name="lang" type="STRING" />
			<column name="term" type="STRING" />
			<column name="canonical_en" type="STRING" />
			<column name="description" type="STRING" />
			<column name="category_hint" type="STRING" />
		</loadData>
		<rollback>
			<delete tableName="TH_FOOD_TERM" />
		</rollback>
	</changeSet>
</databaseChangeLog>
