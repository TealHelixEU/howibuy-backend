			<column name="e_land_water_acidification" type="NUMERIC" />
			<column name="e_freshwater_eutrophication" type="NUMERIC" />
			<column name="e_marine_eutrophication" type="NUMERIC" />
			<column name="e_terrestrial_eutrophication" type="NUMERIC" />
			<column name="e_freshwater_ecotoxicity" type="NUMERIC" />
			<column name="e_land_use" type="NUMERIC" />
			<column name="e_water_use" type="NUMERIC" />
			<column name="e_energy_use" type="NUMERIC" />
			<column name="e_mineral_use" type="NUMERIC" />
			<column name="aw_index" type="NUMERIC" />
			<column name="aw_antibio_index" type="NUMERIC" />
			<column name="s_child_labour" type="NUMERIC" />
			<column name="s_forced_labour" type="NUMERIC" />
			<column name="s_fair_salary" type="NUMERIC" />
			<column name="s_working_time" type="NUMERIC" />
			<column name="s_discrimination" type="NUMERIC" />
			<column name="s_health_safety_workers" type="NUMERIC" />
			<column name="s_social_benefits_legal_issues" type="NUMERIC" />
			<column name="s_workers_rights" type="NUMERIC" />
			<column name="s_fair_competition" type="NUMERIC" />
			<column name="s_corruption" type="NUMERIC" />
			<column name="s_contribution_econ_dev" type="NUMERIC" />
			<column name="s_illiteracy" type="NUMERIC" />
			<column name="s_health_safety_society" type="NUMERIC" />
			<column name="s_indigenous_rights" type="NUMERIC" />
			<column name="nutri_score" type="STRING" />
			<column name="nutri_score_points" type="NUMERIC" />
		</loadUpdateData>
		<rollback>
			<loadUpdateData tableName="TH_ARCHETYPE_PRODUCT" file="db/archetype/archetype_product.csv" relativeToChangelogFile="false" primaryKey="id">
				<column name="id" type="UUID" />
				<column name="category_id" type="UUID" />
				<column name="name" type="STRING" />
				<column name="agb_code" type="STRING" />
				<column name="e_climate_change" type="NUMERIC" />
