	</changeSet>

	<!--
		Only once the points are loaded: a database first migrated without appdata and then with it runs the original
		product load, which has no points, after every changeset without a context. Until then the changeset is skipped
		and tried again on the next update.
	-->
	<changeSet id="archetype_product_nutri_score_points_not_null" author="nikospara">
		<preConditions onFail="CONTINUE">
			<changeSetExecuted changeLogFile="changelogs/v1.0.0/20261105_sustainability_scoring.xml" id="archetype_data_products_v2026-10-27" author="nikospara" />
		</preConditions>
		<addNotNullConstraint tableName="TH_ARCHETYPE_PRODUCT" columnName="nutri_score_points" constraintName="NL_TH_ARCHETYPE_PRODUCT__NUTRI_SCORE_POINTS" />
	</changeSet>

	<changeSet id="purchased_basket_product_score_socio_economic" author="nikospara">
		<renameColumn tableName="TH_PURCHASED_BASKET_PRODUCT" oldColumnName="score_social" newColumnName="score_socio_economic" />
		<setColumnRemarks tableName="TH_PURCHASED_BASKET_PRODUCT" columnName="score_socio_economic" remarks="The Normalised Score of the Socio-economic dimension" />
		<rollback>
			<setColumnRemarks tableName="TH_PURCHASED_BASKET_PRODUCT" columnName="score_socio_economic" remarks="The Normalised Score of the Social dimension" />
			<renameColumn tableName="TH_PURCHASED_BASKET_PRODUCT" oldColumnName="score_socio_economic" newColumnName="score_social" />
		</rollback>
	</changeSet>
</databaseChangeLog>
