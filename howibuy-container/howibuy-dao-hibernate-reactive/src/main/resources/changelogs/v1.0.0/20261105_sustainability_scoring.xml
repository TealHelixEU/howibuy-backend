<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd
	http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd"
>
	<changeSet id="archetype_product_nutri_score_points" author="nikospara">
		<addColumn tableName="TH_ARCHETYPE_PRODUCT">
			<column name="nutri_score_points" type="INTEGER" remarks="The Nutri-Score points behind the label, lower being healthier; WP3's placeholder 0 for a product outside the scheme" />
		</addColumn>
	</changeSet>

	<changeSet id="archetype_data_products_v2026-10-27" author="nikospara" context="appdata">
		<comment>Every value of every product from WP3's database of 2026-10-27, the Nutri-Score points included.</comment>
