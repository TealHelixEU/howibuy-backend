<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>eu.tealhelix</groupId>
		<artifactId>howibuy-container</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>sustainability-scoring</artifactId>

	<name>HowiBuy: Sustainability scoring</name>
	<description>The WP3 sustainability scoring and substitution method, as plain Java with no framework</description>

	<packaging>jar</packaging>

	<dependencies>
		<!-- PROJECT -->
		<dependency>
			<groupId>eu.tealhelix</groupId>
			<artifactId>howibuy-model</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- OTHER -->
		<dependency>
			<groupId>org.immutables</groupId>
			<artifactId>value</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- TEST -->
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.jboss.logmanager</groupId>
			<artifactId>jboss-logmanager</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-no-framework</id>
						<goals><goal>enforce</goal></goals>
						<configuration>
							<rules>
								<!--
									The scoring method is verified against an external reference implementation and must stay runnable
									and debuggable without a container, so framework-freedom is enforced here rather than left to
									review. See ADR 0005. Mutiny is not banned, being a datatype library rather than a framework, but
									nothing on this module's compile classpath pulls it in.
								-->
								<bannedDependencies>
									<excludes>
										<exclude>io.quarkus:*</exclude>
										<exclude>jakarta.enterprise:*</exclude>
										<exclude>jakarta.inject:*</exclude>
										<exclude>jakarta.persistence:*</exclude>
										<exclude>jakarta.ws.rs:*</exclude>
										<exclude>org.hibernate:*</exclude>
										<exclude>org.hibernate.reactive:*</exclude>
										<exclude>eu.tealhelix:howibuy-dao*</exclude>
										<exclude>eu.tealhelix:howibuy-services*</exclude>
										<exclude>eu.tealhelix:tealhelix-common-dao*</exclude>
									</excludes>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
