<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd
	http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd"
>
	<changeSet id="sfc_categories_questions_schema" author="nikospara">
		<createTable tableName="TH_SFC_CATEGORY" remarks="A compass category addressing one sustainability dimension; deliberately thin, all human-facing fields are localized in TH_SFC_CATEGORY_TEXT">
			<column name="id" type="UUID" remarks="The primary key">
				<constraints primaryKey="true" primaryKeyName="PK_TH_SFC_CATEGORY" />
			</column>
			<column name="dimension" type="VARCHAR(32)" remarks="The sustainability dimension the category addresses (SustainabilityDimension enum name); not unique — several categories per dimension are allowed">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_CATEGORY__DIMENSION" />
			</column>
		</createTable>

		<createTable tableName="TH_SFC_CATEGORY_TEXT" remarks="Per-language text of a compass category">
			<column name="category_id" type="UUID" remarks="The category this text localizes; part of the primary key">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_CATEGORY_TEXT__CATEGORY_ID" primaryKey="true" primaryKeyName="PK_TH_SFC_CATEGORY_TEXT" />
			</column>
			<column name="lang" type="VARCHAR(8)" remarks="ISO 639-1 language code, e.g. 'en', 'el'; part of the primary key">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_CATEGORY_TEXT__LANG" primaryKey="true" primaryKeyName="PK_TH_SFC_CATEGORY_TEXT" />
			</column>
			<column name="name" type="VARCHAR(255)" remarks="The category name">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_CATEGORY_TEXT__NAME" />
			</column>
			<column name="description" type="TEXT" remarks="The rich-text category description">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_CATEGORY_TEXT__DESCRIPTION" />
			</column>
			<column name="video_url" type="VARCHAR(1024)" remarks="Link to the category's introductory video; nullable — absent until authored" />
			<column name="detail_url" type="VARCHAR(1024)" remarks="Link to the category's detailed description; nullable — absent until authored" />
		</createTable>
		<addForeignKeyConstraint baseTableName="TH_SFC_CATEGORY_TEXT" baseColumnNames="category_id" constraintName="FK_SFC_CATEGORY_TEXT__CATEGORY_ID__SFC_CATEGORY__ID" referencedTableName="TH_SFC_CATEGORY" referencedColumnNames="id" />

		<createTable tableName="TH_SFC_QUESTION" remarks="A compass question, ordered within its category by position">
			<column name="id" type="UUID" remarks="The primary key">
				<constraints primaryKey="true" primaryKeyName="PK_TH_SFC_QUESTION" />
			</column>
			<column name="category_id" type="UUID" remarks="The category this question belongs to">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_QUESTION__CATEGORY_ID" />
			</column>
			<column name="position" type="SMALLINT" remarks="The 1-based order of the question within its category">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_QUESTION__POSITION" />
			</column>
		</createTable>
		<addForeignKeyConstraint baseTableName="TH_SFC_QUESTION" baseColumnNames="category_id" constraintName="FK_SFC_QUESTION__CATEGORY_ID__SFC_CATEGORY__ID" referencedTableName="TH_SFC_CATEGORY" referencedColumnNames="id" />
		<addUniqueConstraint tableName="TH_SFC_QUESTION" columnNames="category_id, position" constraintName="UQ_TH_SFC_QUESTION__CATEGORY_ID_POSITION" />

		<createTable tableName="TH_SFC_QUESTION_TEXT" remarks="Per-language prompt of a compass question">
			<column name="question_id" type="UUID" remarks="The question this text localizes; part of the primary key">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_QUESTION_TEXT__QUESTION_ID" primaryKey="true" primaryKeyName="PK_TH_SFC_QUESTION_TEXT" />
			</column>
			<column name="lang" type="VARCHAR(8)" remarks="ISO 639-1 language code, e.g. 'en', 'el'; part of the primary key">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_QUESTION_TEXT__LANG" primaryKey="true" primaryKeyName="PK_TH_SFC_QUESTION_TEXT" />
			</column>
			<column name="text" type="TEXT" remarks="The question prompt">
				<constraints nullable="false" notNullConstraintName="NL_TH_SFC_QUESTION_TEXT__TEXT" />
			</column>
		</createTable>
		<addForeignKeyConstraint baseTableName="TH_SFC_QUESTION_TEXT" baseColumnNames="question_id" constraintName="FK_SFC_QUESTION_TEXT__QUESTION_ID__SFC_QUESTION__ID" referencedTableName="TH_SFC_QUESTION" referencedColumnNames="id" />
	</changeSet>

	<changeSet id="sfc_categories_questions_data_categories" author="nikospara" context="appdata">
